		(uuid "201c0ff6-d4ba-4a6c-be18-723a835b79a8")
	)
	(text "U3 CELL connects to raw VBAT, never to a regulated rail."
		(exclude_from_sim no)
		(at 20.32 255.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2f32122f-cb49-40dd-a3ed-06e4e1fa6a75")
	)
	(text "U2 heart-rate module plugs in sensor side UP. Set its pull-up jumper to 3V3."
		(exclude_from_sim no)
		(at 200.66 120.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3210a21c-134c-44a2-a763-b53310e45e98")
	)
	(text "U3 is OPTIONAL (DNP). If absent, the R3/R4 divider on IO34 supplies battery voltage."
		(exclude_from_sim no)
		(at 20.32 251.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "330c06f4-c4ec-450b-a9e0-00cb1638c422")
	)
	(text "Test points: TP1 VBAT - TP2 +5V - TP3 +3V3 - TP4 GND - TP5 SDA"
		(exclude_from_sim no)
		(at 236.22 246.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4117a9f3-3acf-4128-83a0-7029df52ba44")
	)
	(text "SET M2 (MT3608) TO 5.0 V WITH A METER BEFORE CONNECTING U1."
		(exclude_from_sim no)
		(at 20.32 246.38 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "48fed779-67a8-42e6-be95-909567226397")
	)
	(text "IO34 is input-only and has no internal pull-up."
		(exclude_from_sim no)
		(at 20.32 270.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "578ae241-97b9-42bb-97ca-670ac4873497")
	)
	(text "BZ1 and D1 run from +5 V, not +3V3."
		(exclude_from_sim no)
		(at 20.32 259.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "703a5dd5-22a7-4b87-b091-a34f3d604799")
	)
	(text "FIRMWARE: SDA = IO22, SCL = IO21 (swapped from the earlier revision for a single-layer board)."
		(exclude_from_sim no)
		(at 20.32 285.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "78d477ba-6feb-4c22-ad4f-f17496521aba")
	)
	(text "Leave the JST black lead unconnected - U3 GND is already system GND."
		(exclude_from_sim no)
		(at 200.66 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8cbe0b36-b95b-4951-afeb-169d5e56b440")
	)
	(text "Battery + reaches U3 through its JST: red lead to TP4056 OUT+ (VBAT)."
		(exclude_from_sim no)
		(at 200.66 199.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bbf8cc8d-b3ec-46b2-8c37-9627de6cc895")
	)
	(text "IO6-IO11 are wired to the SPI flash and must not be used."
		(exclude_from_sim no)
		(at 20.32 266.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bf469d43-5e41-465d-9f3f-9c01b8088da4")
	)
	(text "R5/R6 fit only if the MAX30102 breakout has no on-board pull-ups."
		(exclude_from_sim no)
		(at 20.32 281.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c24c1b14-cecf-4477-abef-e13d528ec797")
	)
	(text "IO2 is a strapping pin: drive D2 to ground only, never through a pull-up."
		(exclude_from_sim no)
		(at 20.32 262.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f5c9a585-222f-4031-beb8-62a8fa13ca4d")
	)
	(text "Layout: keep M2 at the opposite board edge from the ESP32 antenna. No copper under the antenna."
		(exclude_from_sim no)
		(at 20.32 274.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f746f3ef-50b1-4cea-959f-edce5d699082")
	)
	(text "Decoupling 100 nF at each module VCC pin, not all drawn."
		(exclude_from_sim no)
		(at 236.22 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
