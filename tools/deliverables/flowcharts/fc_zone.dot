digraph Z {
  #include
  s   [label="Every 200 ms", shape=box, style=rounded];
  f   [label="Drop beacons not heard for 2.5 s;\nignore beacons below −88 dBm"];
  any [label="Any beacon\nleft?", shape=diamond];
  kn  [label="Zone known and\nWi-Fi not using\nthe radio?", shape=diamond];
  cnt [label="No-beacon count + 1"];
  c30 [label="Count ≥ 30\n(6 s)?", shape=diamond];
  unk [label="Zone = unknown;\nsend \"location unknown\"", shape=parallelogram];
  cu  [label="Current zone\nunknown?", shape=diamond];
  take[label="Zone = strongest beacon"];
  same[label="Strongest =\ncurrent zone?", shape=diamond];
  lead[label="Leads current\nby > 5 dB?", shape=diamond];
  need[label="Required hold: 0.4 s if lead ≥ 10 dB,\notherwise 1.6 s"];
  held[label="Same challenger\nfor the whole hold?", shape=diamond];
  chg [label="Zone = challenger"];
  rst [label="Reset challenger count"];
  res [label="Restricted\nzone?", shape=diamond];
  ar  [label="Buzzer (4 beeps); send\n\"entered restricted zone\"", shape=parallelogram];
  az  [label="Send \"moved zone\"", shape=parallelogram];
  e   [label="End of pass", shape=box, style=rounded];
  s->f->any;
  any->kn [xlabel="No"]; any->cu [xlabel="Yes"];
  kn->cnt [xlabel="Yes"]; kn->e [xlabel="No"];
  cnt->c30; c30->unk [xlabel="Yes"]; c30->e [xlabel="No"]; unk->e;
  cu->take [xlabel="Yes"]; cu->same [xlabel="No"]; take->res;
  same->rst [xlabel="Yes"]; same->lead [xlabel="No"];
  lead->need [xlabel="Yes"]; lead->rst [xlabel="No"];
  need->held; held->chg [xlabel="Yes"]; held->e [xlabel="No"];
  chg->res; res->ar [xlabel="Yes"]; res->az [xlabel="No"];
  ar->e; az->e; rst->e;
}
