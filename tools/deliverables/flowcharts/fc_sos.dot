digraph S {
  #include
  s   [label="Every pass of the main loop", shape=box, style=rounded];
  ack [label="Status reply: no open SOS\n(caregiver acknowledged)?", shape=diamond];
  clr [label="Leave SOS mode;\nlong low tone"];
  prs [label="New press?\n(40 ms debounce)", shape=diamond];
  cnt [label="Count press (max 3);\nshort tick"];
  done[label="Released, and 0.7 s\nsince the last press?", shape=diamond];
  stronger[label="No SOS open, or more\npresses than the open one?", shape=diamond];
  send[label="Send SOS, urgency 1–3\n(new or escalated);\n1–3 beeps", shape=parallelogram];
  rep [label="Repeat the tone only"];
  hold[label="Button held?", shape=diamond];
  h3  [label="Held ≥ 3 s?", shape=diamond];
  tick[label="Soft tick each\nfull second"];
  dis [label="Leave SOS mode; send\n\"SOS dismissed\"; long low tone", shape=parallelogram];
  e   [label="Return", shape=box, style=rounded];
  s->ack; ack->clr [xlabel="Yes"]; ack->prs [xlabel="No"]; clr->prs;
  prs->cnt [xlabel="Yes"]; prs->done [xlabel="No"]; cnt->done;
  done->stronger [xlabel="Yes"]; done->hold [xlabel="No"];
  stronger->send [xlabel="Yes"]; stronger->rep [xlabel="No"]; send->hold; rep->hold;
  hold->h3 [xlabel="Yes"]; hold->e [xlabel="No"];
  h3->dis [xlabel="Yes"]; h3->tick [xlabel="No"]; dis->e; tick->e;
}
