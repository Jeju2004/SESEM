// Wide variant of arch_col.dot for the user manual: panels (a) and (b) side by side.
digraph A {
  graph [fontname="Liberation Sans", fontsize=13, rankdir=TB, nodesep=0.12, ranksep=0.22, bgcolor="white", pad=0.08, newrank=true, compound=true];
  node  [fontname="Liberation Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#000000", penwidth=1, margin="0.08,0.04", width=0, height=0];
  edge  [fontname="Liberation Sans", fontsize=11, arrowsize=0.6, penwidth=1, color="#000000"];

  subgraph cluster_a { label=<<b>(a) Stand-alone hub — demonstrated</b><br/><font point-size="11">no computer, router or internet</font>>; labeljust=l; style="rounded"; color="#000000";
    subgraph cluster_bz { label=<<font point-size="11">Zone beacons (BLE iBeacon, +9 dBm)</font>>; style="dashed"; color="#000000";
      bw [label=<<b>Bedroom Wing</b><br/><font point-size="10">zone 1 · safe</font>>, fillcolor="#ffffff"];
      dh [label=<<b>Dining Hall</b><br/><font point-size="10">zone 2 · safe</font>>, fillcolor="#ffffff"];
      mr [label=<<b>Medicine Room</b><br/><font point-size="10">zone 11 · restricted</font>>, fillcolor="#ffffff"];
      {rank=same; bw; dh; mr;} bw -> dh -> mr [style=invis];
    }
    wr [label=<<b>Wearable (ESP32)</b><br/><font point-size="10">strongest beacon wins · SOS button (1–3 presses)<br/>buzzer · LED · MAX30102 heart rate · battery<br/>queues events while offline</font>>, fillcolor="#ffffff"];
    hub [label=<<b>Door node = SESEMSG hub (ESP32)</b><br/><font point-size="10">reed switch on the restricted door<br/>own Wi-Fi "SESEMSG" · captive portal<br/>serves the caregiver dashboard<br/>alert rules · passcode · acknowledge<br/>"not reporting" watchdog (30 s)<br/>sos_open → wearable clears its SOS<br/>same API as the computer server</font>>, fillcolor="#ffffff"];
    ph [label=<<b>Caregiver phones (up to 7)</b><br/><font point-size="10">scan QR → join → dashboard<br/>SOS alarm sound · vibration · passcode</font>>, fillcolor="#ffffff"];
    dh -> wr [label="  RSSI", ltail=cluster_bz, minlen=2];
    wr -> hub [label="  Wi-Fi (WPA2)", minlen=2];
    hub -> ph [dir=both];
  }
  subgraph cluster_b { label=<<b>(b) Facility network — alternative</b>>; labeljust=l; style="rounded"; color="#000000";
    w2 [label=<<b>Wearable</b><br/><font point-size="10">same firmware</font>>, fillcolor="#ffffff"];
    d2 [label=<<b>Door node</b><br/><font point-size="10">normal build</font>>, fillcolor="#ffffff"];
    fw [label=<<b>Facility Wi-Fi</b>>, fillcolor="#ffffff"];
    pc [label=<<b>Dashboard computer</b><br/><font point-size="10">FastAPI · SQLite history</font>>, fillcolor="#ffffff"];
    br [label=<<b>Caregiver browsers</b>>, fillcolor="#ffffff"];
    {rank=same; w2; d2;}
    w2 -> fw; d2 -> fw; fw -> pc -> br;
  }
  cr [label=<<b>Further study: cloud relay</b><br/><font point-size="10">hub pushes a summary over HTTPS;<br/>phones view from any network<br/>(built and tested locally, not deployed)</font>>, style="rounded,dashed", fillcolor="#ffffff"];
  {rank=same; wr; w2;}
  br -> cr [style=invis];
  hub -> cr [style=dashed, constraint=false];
}
