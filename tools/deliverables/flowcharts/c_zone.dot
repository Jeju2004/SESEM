digraph Z { #include
  // centre: classification with reset terminators; connector B: zone-unknown shortcut; right: no-beacon branch
  node [margin="0.04,0.02"];
  s  [label="Every 200 ms", style=rounded];
  a  [label="Drop beacons silent 2.5 s\nor below −88 dBm"];
  d1 [label="Any beacon\nleft?", shape=diamond];
  d2 [label="Zone\nunknown?", shape=diamond];
  d3 [label="Strongest\nleads current\nby > 5 dB?", shape=diamond];  e1 [label="Reset;\nend", style=rounded];
  p  [label="Hold 0.4 s if lead ≥ 10 dB,\notherwise 1.6 s"];
  d5 [label="Lead held\nthroughout?", shape=diamond];  e3 [label="Reset;\nend", style=rounded];
  c  [label="Zone = strongest"];
  b1 [label="B", shape=circle, width=0.3, fixedsize=true];  b2 [label="B", shape=circle, width=0.3, fixedsize=true];
  d6 [label="Restricted?", shape=diamond];
  ar [label="Buzzer; send\n\"restricted zone\"", shape=parallelogram, fixedsize=true, width=1.75, height=0.5];
  az [label="Send\n\"moved zone\"", shape=parallelogram, fixedsize=true, width=1.45, height=0.5];
  e4 [label="End", style=rounded];
  n1 [label="Zone known,\nradio free?", shape=diamond];
  n2 [label="No-beacon\ncount + 1"];
  n3 [label="Count ≥ 30\n(6 s)?", shape=diamond];
  n4 [label="Zone = unknown;\nsend \"location\nunknown\"", shape=parallelogram, fixedsize=true, width=1.75, height=0.68];
  e7 [label="End", style=rounded];
  s->a->d1; d1->n1 [xlabel="No"]; d1->d2 [xlabel="Yes"];
  d2->b1 [xlabel="Yes"]; b2->c; d2->d3 [xlabel="No"];
  d3->e1 [xlabel="No"]; d3->p [xlabel="Yes"]; p->d5;
  d5->e3 [xlabel="No"]; d5->c [xlabel="Yes"]; c->d6;
  d6->ar [xlabel="Yes"]; d6->az [xlabel="No"]; ar->e4; az->e4;
  n1->n2 [xlabel="Yes"]; n2->n3; n3->n4 [xlabel="Yes"]; n4->e7;
  n1:e->e7:e [xlabel="No"]; n3:e->e7:e [xlabel="No"];
  {rank=same; d1; n1;} {rank=same; d2; b1;} {rank=same; b2; c;} {rank=same; d3; e1;} {rank=same; d5; e3;} {rank=same; d6; ar;} {rank=same; az; e4;}
}
