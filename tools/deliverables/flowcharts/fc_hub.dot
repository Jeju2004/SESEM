digraph H {
  #include
  r   [label="Request received from wearable,\ndoor node or dashboard", shape=parallelogram];
  st  [label="Status\nreport?", shape=diamond];
  st1 [label="Update resident card; clear\n\"device not reporting\"; if a zone\nis known, clear \"location unknown\""];
  st2 [label="Reply: number of open SOS", shape=parallelogram];
  al  [label="Alert?", shape=diamond];
  dup [label="Same event within 30 s,\nor \"location unknown\"\nalready open?", shape=diamond];
  mrg [label="Merge (no new alert)"];
  typ [label="SOS: retire the weaker open SOS.\nZone change: clear \"location unknown\""];
  sto [label="Store alert"];
  dr  [label="Door\nevent?", shape=diamond];
  d1  [label="Update door state; opened:\n\"restricted door opened\" (critical)"];
  ak  [label="Acknowledgement: record\ncaregiver name and time"];
  show[label="Dashboards update within 1 s", shape=parallelogram];
  w0  [label="Every 5 s (watchdog)", shape=box, style=rounded];
  we  [label="Wait", shape=box, style=rounded];
  wd  [label="Wearable silent > 30 s and\nno uncleared \"not reporting\"?", shape=diamond];
  off [label="Raise \"device not reporting\""];
  r->st; st->st1 [xlabel="Yes"]; st1->st2->show;
  st->al [xlabel="No"]; al->dup [xlabel="Yes"]; dup->mrg [xlabel="Yes"]; dup->typ [xlabel="No"]; typ->sto->show; mrg->show;
  al->dr [xlabel="No"]; dr->d1 [xlabel="Yes"]; dr->ak [xlabel="No"]; d1->show; ak->show;
  w0->wd; wd->off [xlabel="Yes"]; wd->we [xlabel="No"]; off->show;
}
