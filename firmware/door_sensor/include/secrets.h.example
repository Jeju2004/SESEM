#pragma once
// Copy this file to secrets.h (same folder) and fill it in.
// secrets.h is ignored by git, so the WiFi password never reaches GitHub.

#define WIFI_SSID          "your-wifi-name"
#define WIFI_PASSWORD      "your-wifi-password"

// The PC running the dashboard backend. Find its address with `ipconfig`
// (IPv4 Address of the WiFi adapter); the wearable and the PC must be on the
// same WiFi network.
#define BACKEND_BASE_URL   "http://192.168.1.100:8000"

// --- Hub mode only (env esp32hub) --------------------------------------------
// The node's own Wi-Fi network, and the passcode of the dashboard it serves.
// WPA2 needs a password of at least 8 characters.
#define HUB_AP_SSID        "SESEMSG"
#define HUB_AP_PASSWORD    "change-me-8-chars"
#define HUB_PASSCODE       "000000"   // digits only (the dashboard shows a keypad); pick your own

// Hub mode, optional: more networks the hub may use to reach the internet
// (tried in order after WIFI_SSID), and the cloud relay for remote viewing.
// #define WIFI2_SSID         "pocket-router-name"
// #define WIFI2_PASSWORD     "pocket-router-password"
// #define RELAY_URL          "https://sesemsg.your-account.workers.dev"
// #define RELAY_KEY          "the relay's HUB_KEY secret"
