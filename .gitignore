.pio/
__pycache__/
*.pyc
*.csv
*.png
# ...except raw test captures, which are Chapter 4 evidence
!data/**/*.csv
!tools/deliverables/figures/*.png
node_modules/
*.bak

# Dashboard / database
*.db
*.sqlite
*.sqlite3
.venv/
venv/
.env

# Firmware credentials (WiFi password, backend address)
firmware/**/secrets.h
# Generated at build time from dashboard/static/v2 (scripts/embed_dashboard.py)
firmware/door_sensor/include/hub_page.h

# KiCad (hardware/)
!hardware/**/artwork/*.png
# Enclosure renders and perfboard diagrams (the build notes embed them)
!hardware/enclosures/**/*.png
!hardware/beacon_node/*.png
!deliverables/final/**/*.png
*.lck
*.kicad_prl
fp-info-cache
*-backups/

# Cloud relay: local secrets, generated page, wrangler cache
relay/.dev.vars
relay/src/page.html
relay/.wrangler/

# Office lock files
~$*

# 30 Sep demo evidence: phone screenshots of the hub dashboard
!data/demo/**/*.png
